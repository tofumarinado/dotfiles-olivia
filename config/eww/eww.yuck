(include "eww_widgets.yuck")

(defwindow yearbox
  :monitor '[0]'
  :stacking "bg"
  :namespace "eww"
  :geometry (geometry
    :x "40"
    :y "40"
    :width "75"
    :height "75"
    :anchor "bottom right")
  (yearbox)
)

(defwindow monthbox
  :monitor '[0]'
  :stacking "bg"
  :namespace "eww"
  :geometry (geometry
    :x "130"
    :y "40"
    :width "75"
    :height "75"
    :anchor "bottom right")
  (monthbox)
)

(defwindow daybox
  :monitor '[0]'
  :stacking "bg"
  :namespace "eww"
  :geometry (geometry
    :x "220"
    :y "40"
    :width "75"
    :height "75"
    :anchor "bottom right")
  (daybox)
)

(defwindow userinfo
  :monitor '[0]'
  :stacking "bg"
  :namespace "eww"
  :geometry (geometry
    :x "40"
    :y "125"
    :width "75"
    :height "75"
    :anchor "bottom right")
  (userinfobox)
)

(defwindow powermenu
  :monitor '[0]'
  :stacking "bg"
  :namespace "eww"
  :geometry (geometry
    :x "40"
    :y "125"
    :width "75"
    :height "75"
    :anchor "bottom right")
  (powermenu)
)

(defwindow audio
  :monitor '[0]'
  :stacking "overlay"
  :focusable true
  :namespace "eww"
  :geometry (geometry
    :x "200"
    :y "5"
    :width "180"
    :anchor "top right")
  (audio)
)
